# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env   (ou: Copy-Item .env.example .env no PowerShell)

# Ollama (local) — obrigatório enquanto LLM_PROVIDER=ollama (padrão)
# Instale o Ollama (https://ollama.com) e baixe os modelos usados por este agente:
#   ollama pull mistral   # geração (OLLAMA_MODEL)
#   ollama pull phi4      # revisão independente (OLLAMA_REVIEW_MODEL)
#   ollama pull bge-m3    # embeddings (OLLAMA_EMBEDDING_MODEL) — sem toggle, sempre Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_REVIEW_MODEL=phi4
OLLAMA_EMBEDDING_MODEL=bge-m3
# Alternativa de embedding ainda nao implementada/testada (sem toggle hoje, so documentada):
# Google Embedding API (gemini-embedding-1, gemini-embedding-2).

# Provedor de LLM ativo p/ geração/revisão: "ollama" (padrão), "nvidia" (NVIDIA NIM,
# build.nvidia.com), "cerebras" (Cerebras Inference, api.cerebras.ai), "google" (Google AI
# Studio, aistudio.google.com) ou "groq" (Groq, console.groq.com). Piloto opcional — não
# altera o comportamento padrão se deixado comentado/ausente. Não afeta embeddings (sempre
# Ollama, sem toggle).
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
# NVIDIA_REVIEW_MODEL=meta/llama-3.3-70b-instruct

# LLM_PROVIDER=cerebras
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_REVIEW_MODEL=zai-glm-4.7

# LLM_PROVIDER=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.1-flash-lite
# GOOGLE_REVIEW_MODEL=gemini-2.5-flash-lite
# gemini-3.5-flash: testado no SA, mas quota do tier gratuito e so 20 req/dia (esgota rapido).
# gemini-3.6-flash: tier gratuito e so 5 req/min (pior que o 3.1-flash-lite). gemma-4-26b:
# 404 (ID exato do modelo na API diverge do nome comercial no dashboard, nao confirmado).
# Outros fallbacks conhecidos, ainda nao testados: gemini-3-flash-live, gemma-4-31b.

# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_REVIEW_MODEL=openai/gpt-oss-120b
# Adicionado ao vivo processando o PRD real "Mais Saude Publica": os 3 provedores em nuvem
# acima saturaram ou tiveram rate limit baixo demais (15 ou 5 req/min no tier gratuito do
# Google) para gerar varias stories em lote (~30 chamadas em rajada). Groq confirmado pelo
# usuario com 30 req/min tanto no gerador quanto no revisor.

# Jira Cloud — obrigatório apenas para usar --jira / --criar-jira
# Token gerado em id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://seu-site.atlassian.net/
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_EPIC_ISSUE_TYPE_ID=
JIRA_STORY_ISSUE_TYPE_ID=

# Confluence Cloud — obrigatório apenas para usar --confluence / --publicar-confluence
# Usa as mesmas credenciais do Jira (JIRA_EMAIL / JIRA_API_TOKEN) acima.
CONFLUENCE_SPACE_KEY=   # obrigatório apenas para usar --publicar-confluence
